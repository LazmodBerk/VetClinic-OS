# ============================================================
# VCMS - Ortam Değişkenleri
# Bu dosyayı kopyalayıp .env olarak kaydedin,
# sonra kendi değerlerinizi girin.
# ============================================================

# --- Veritabanı ---
# Yerel geliştirme için SQLite (varsayılan):
DATABASE_URL=sqlite:///./vcms.db

# Supabase PostgreSQL (production):
# DATABASE_URL=postgresql://postgres.XXXX:PAROLA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- JWT Güvenlik ---
SECRET_KEY=cok-gizli-bir-anahtar-buraya-degistirin-32-karakter
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- SMS (Netgsm) ---
# https://www.netgsm.com.tr
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=KLINIK

# --- WhatsApp Business (Meta Cloud API) ---
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Web Push (PWA Bildirimleri) ---
# Üretmek için: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT_EMAIL=admin@klinigim.com

# --- Frontend URL (CORS için) ---
FRONTEND_URL=http://localhost:5173
